---

<Layout title="Sobre mí - Alejandro Sandoval">
  <NavBar currentPath="/sobre-mi" />

  <div
    class="space-y-12 md:space-y-32 pb-32 md:pb-40 px-2 md:px-8 w-full max-w-[90rem] mx-auto flex flex-col overflow-visible"
  >
    <div class="flex justify-center mt-6 md:mt-8">
      <h1
        class="font-display text-3xl md:text-5xl lg:text-7xl bg-p5-red text-p5-white inline-block px-4 sm:px-6 md:px-12 py-2 sm:py-3 md:py-6 -skew-x-[6deg] shadow-[4px_4px_0_0_#0F0F0F] sm:shadow-[8px_8px_0_0_#0F0F0F] md:shadow-[12px_12px_0_0_#0F0F0F] mb-4 md:mb-8 border-4 border-p5-black ml-2 sm:ml-0"
      >
        <span class="inline-block skew-x-[6deg]">
          <span class="lang-es">ARCHIVO DE PERFIL</span>
          <span class="lang-en">PROFILE ARCHIVE</span>
        </span>
      </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-10 gap-6 md:gap-10">
      <section class="relative md:col-span-6">
        <div
          class="absolute -top-4 md:-top-6 left-0 md:-left-4 bg-p5-red text-p5-white px-4 md:px-6 py-1 md:py-2 font-display text-xl md:text-3xl -skew-x-[6deg] z-10 border-2 border-p5-black shadow-[4px_4px_0_0_#0F0F0F]"
        >
          <span class="inline-block skew-x-[6deg]">
            <span class="lang-es">QUIÉN SOY</span>
            <span class="lang-en">WHO AM I</span>
          </span>
        </div>
        <div
          class="bg-p5-black border-4 border-p5-red p-4 sm:p-5 md:p-8 lg:p-10 shadow-[4px_4px_0_0_#F4F4F4] sm:shadow-[8px_8px_0_0_#F4F4F4] md:shadow-[12px_12px_0_0_#F4F4F4] pt-10 sm:pt-12 md:pt-16 relative overflow-hidden h-full"
        >
          <div
            class="absolute inset-0 bg-halftone opacity-10 pointer-events-none"
          >
          </div>

          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 lg:gap-12 relative z-10"
          >
            <div class="flex flex-col gap-3 md:gap-4 pl-2 sm:pl-0">
              <div
                class="bg-p5-white text-p5-black px-3 md:px-4 py-2 md:py-3 border-2 md:border-4 border-p5-black -skew-x-[6deg] shadow-[3px_3px_0_0_#E50012] sm:shadow-hard"
              >
                <span
                  class="inline-block skew-x-[6deg] font-mono text-xs md:text-xs text-p5-red uppercase tracking-widest block mb-0.5 md:mb-1"
                >
                  <span class="lang-es">UBICACIÓN</span>
                  <span class="lang-en">LOCATION</span>
                </span>
                <span
                  class="inline-block skew-x-[6deg] font-display text-base sm:text-lg md:text-2xl uppercase leading-none"
                >
                  Colombia
                </span>
              </div>
              <div
                class="bg-p5-white text-p5-black px-3 md:px-4 py-2 md:py-3 border-2 md:border-4 border-p5-black -skew-x-[6deg] shadow-[3px_3px_0_0_#E50012] sm:shadow-hard"
              >
                <span
                  class="inline-block skew-x-[6deg] font-mono text-xs md:text-xs text-p5-red uppercase tracking-widest block mb-0.5 md:mb-1"
                >
                  <span class="lang-es">PERFIL</span>
                  <span class="lang-en">PROFILE</span>
                </span>
                <span
                  class="inline-block skew-x-[6deg] font-display text-base sm:text-lg md:text-2xl uppercase leading-none"
                >
                  Game Dev &amp; UI
                </span>
              </div>
              <div
                class="bg-p5-white text-p5-black px-3 md:px-4 py-2 md:py-3 border-2 md:border-4 border-p5-black -skew-x-[6deg] shadow-[3px_3px_0_0_#E50012] sm:shadow-hard"
              >
                <span
                  class="inline-block skew-x-[6deg] font-mono text-xs md:text-xs text-p5-red uppercase tracking-widest block mb-0.5 md:mb-1"
                >
                  <span class="lang-es">EXPERIENCIA</span>
                  <span class="lang-en">EXPERIENCE</span>
                </span>
                <span
                  class="inline-block skew-x-[6deg] font-display text-base sm:text-lg md:text-2xl uppercase leading-none"
                >
                  <span class="lang-es">1+ AÑO</span>
                  <span class="lang-en">1+ YEAR</span>
                </span>
              </div>
            </div>

            <div class="md:col-span-2 flex flex-col gap-5 md:gap-8 justify-center">
              <p
                class="font-body text-sm md:text-lg lg:text-xl text-p5-white leading-relaxed border-l-4 md:border-l-8 border-p5-red pl-4 md:pl-8"
              >
                <span class="lang-es"
                  >Soy Alejandro Sandoval, ingeniero multimedia enfocado en crear
                  experiencias interactivas. Combino programación, diseño visual,
                  narrativa y experiencia de usuario para construir mundos que se
                  sientan vivos y memorables para quienes los recorren.</span
                >
                <span class="lang-en"
                  >I am Alejandro Sandoval, a multimedia engineer focused on
                  building interactive experiences. I combine programming, visual
                  design, narrative, and user experience to create worlds that
                  feel alive and memorable for the people who explore them.</span
                >
              </p>
              <p
                class="font-body text-xs md:text-base lg:text-lg text-p5-white opacity-70 leading-relaxed border-l-4 border-p5-white/30 pl-4 md:pl-8"
              >
                <span class="lang-es"
                  >Me especializo en Unity y C#, con experiencia adicional en
                  modelado 3D, diseño de interfaces y desarrollo web. Actualmente
                  estoy cerrando mi etapa universitaria mientras busco mi primera
                  oportunidad profesional en la industria.</span
                >
                <span class="lang-en"
                  >I specialize in Unity and C#, with additional experience in 3D
                  modeling, interface design, and web development. I am currently
                  finishing university while looking for my first professional
                  opportunity in the industry.</span
                >
              </p>
              <div class="pt-4 self-start">
                <P5Button
                  href="/Assets/CV_Alejandro_Sandoval.pdf"
                  variant="primary"
                  download="CV_Alejandro_Sandoval.pdf"
                  className="group"
                >
                  <svg
                    slot="icon"
                    class="w-6 h-6 mr-1 group-hover/btn:animate-bounce"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"
                    ></path>
                  </svg>
                  <span class="lang-es">DESCARGAR CV / HOJA DE VIDA</span>
                  <span class="lang-en">DOWNLOAD RESUME / CV</span>
                </P5Button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="flex items-stretch pt-0 md:pt-16 md:col-span-4">
        <CallingCard
          client:load
          name="ALEJANDRO SANDOVAL"
          email="asandoval123871@gmail.com"
          linkedin="https://www.linkedin.com/in/alejandro-sandoval-8a9209285/"
          github="https://github.com/ImJustSandie"
          orcid="0009-0004-1351-8391"
          sketchfab="https://sketchfab.com/ImJustSandie"
          className="w-full h-full"
        />
      </div>
    </div>

    <section class="relative">
      <div
        class="absolute -top-4 md:-top-6 left-0 md:-left-4 bg-p5-black text-p5-white px-3 md:px-6 py-1 md:py-2 font-display text-lg md:text-3xl -skew-x-[6deg] z-10 border-2 border-p5-white shadow-[4px_4px_0_0_#E50012]"
      >
        <span class="inline-block skew-x-[6deg]">
          <span class="lang-es">01. FILOSOFÍA DE TRABAJO</span>
          <span class="lang-en">01. WORK PHILOSOPHY</span>
        </span>
      </div>
      <div
        class="bg-p5-white border-4 border-p5-black p-3 sm:p-4 md:p-8 lg:p-12 shadow-[4px_4px_0_0_var(--shadow-color)] sm:shadow-hard-adaptive pt-8 sm:pt-10 md:pt-12 relative overflow-hidden group"
      >
        <div
          class="absolute right-0 bottom-0 opacity-5 pointer-events-none transform translate-x-4 translate-y-12"
        >
          <span class="font-display text-[200px] leading-none">"</span>
        </div>
        <p
          class="font-body text-base md:text-xl lg:text-2xl text-p5-black font-bold leading-relaxed border-l-4 md:border-l-8 border-p5-red pl-3 md:pl-6 relative z-10"
        >
          <span class="lang-es"
            >Trabajo desde la iteración y la escucha. Me gusta diseñar sistemas
            a partir de necesidades reales, mantener una arquitectura limpia y
            modular, y asegurar que lo visual no sea un adorno sino parte
            esencial de la experiencia. Busco que cada proyecto funcione bien,
            escale con criterio y también transmita intención, personalidad y
            cuidado.</span
          >
          <span class="lang-en"
            >I work through iteration and close listening. I like designing
            systems around real needs, keeping the architecture clean and
            modular, and making sure the visual layer is not decoration but an
            essential part of the experience. I want every project to work well,
            scale thoughtfully, and also communicate intention, personality, and
            care.</span
          >
        </p>
      </div>
    </section>

    <section class="relative flex justify-end">
      <div class="w-full md:w-[90%] relative">
        <div
          class="absolute -top-4 md:-top-6 right-0 md:-right-4 bg-p5-red text-p5-white px-3 md:px-6 py-1 md:py-2 font-display text-lg md:text-3xl -skew-x-[6deg] z-10 border-2 border-p5-black shadow-[4px_4px_0_0_#0F0F0F]"
        >
          <span class="inline-block skew-x-[6deg]">
            <span class="lang-es">02. POR QUÉ GAMEDEV</span>
            <span class="lang-en">02. WHY GAMEDEV</span>
          </span>
        </div>
        <div
          class="bg-p5-black border-4 border-p5-red p-3 sm:p-4 md:p-8 lg:p-12 shadow-[4px_4px_0_0_#F4F4F4] sm:shadow-[8px_8px_0_0_#F4F4F4] md:shadow-[12px_12px_0_0_#F4F4F4] pt-8 sm:pt-10 md:pt-12 relative overflow-hidden group hover:border-p5-white transition-colors duration-500"
        >
          <div class="absolute inset-0 bg-halftone opacity-20"></div>
          <div
            class="absolute -left-10 top-1/2 transform -translate-y-1/2 -rotate-90 opacity-10"
          >
            <span class="font-display text-8xl tracking-widest text-p5-red"
              >PASSION</span
            >
          </div>
          <p
            class="font-body text-sm md:text-lg lg:text-xl text-p5-white leading-relaxed relative z-10 border-r-4 border-p5-red pr-3 md:pr-6 text-right"
          >
            <span class="lang-es"
              >Siempre me han atraído los mundos capaces de atraparte por su
              historia, sus personajes, sus mecánicas y la forma en que todo
              dialoga para decir algo. Los videojuegos, para mí, son el punto de
              encuentro perfecto entre tecnología, arte e interacción. Por eso
              quiero formar parte de equipos que busquen dejar huella a través
              de experiencias inolvidables. Adicionalmente, soy fiel creyente de
              que quienes crean videojuegos deben ser primero amantes de los
              mismos, me considero a mi mismo una persona que siente gran pasión
              por este arte.
            </span>
            <span class="lang-en"
              >I have always been drawn to worlds that pull you in through
              story, characters, mechanics, and the way every layer works
              together to say something meaningful. To me, games are the perfect
              meeting point between technology, art, and interaction. That is
              why I want to be part of teams that aim to leave a mark through
              unforgettable experiences. Additionally, I am a firm believer that
              those who create video games must first be lovers of the same, I
              consider myself a person who feels great passion for this art.
            </span>
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-6 md:space-y-8">
      <h3
        class="font-display text-2xl md:text-4xl text-p5-red border-b-2 border-p5-red pb-1 md:pb-2 inline-block -skew-x-[6deg] ml-2 sm:ml-0"
      >
        <span class="inline-block skew-x-[6deg]">
          <span class="lang-es">03. Barras de Experiencia</span>
          <span class="lang-en">03. Experience Bars</span>
        </span>
      </h3>
      <div
          class="bg-panel border-2 sm:border-4 border-adaptive shadow-[4px_4px_0_0_var(--shadow-color)] sm:shadow-hard-adaptive skew-x-[3deg] overflow-x-clip"
      >
        <div
          class="-skew-x-[3deg] p-4 md:p-8 lg:p-12 grid grid-cols-1 md:grid-cols-2 gap-x-8 lg:gap-x-16 gap-y-6 md:gap-y-8 overflow-x-clip"
        >
          {
            (confidantSkills as ConfidantBarProps[]).map((skill) => (
              <ConfidantBar
                client:load
                title={skill.title}
                rank={skill.rank}
                percentage={skill.percentage}
                description={skill.description}
                tags={skill.tags}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative">
      <div
        class="absolute -top-4 md:-top-6 left-0 md:-left-4 bg-p5-black text-p5-white px-3 md:px-6 py-1 md:py-2 font-display text-lg md:text-3xl -skew-x-[6deg] z-10 border-2 border-p5-white shadow-[4px_4px_0_0_#E50012]"
      >
        <span class="inline-block skew-x-[6deg]">
          <span class="lang-es">04. TIMELINE ACADÉMICA</span>
          <span class="lang-en">04. ACADEMIC TIMELINE</span>
        </span>
      </div>
      <div
        class="bg-p5-white border-4 border-p5-black p-3 sm:p-4 md:p-8 lg:p-12 shadow-[4px_4px_0_0_var(--shadow-color)] sm:shadow-hard-adaptive pt-10 sm:pt-12 md:pt-16"
      >
        <details class="group">
          <summary class="list-none cursor-pointer">
            <div
              class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 md:gap-4 bg-p5-black text-p5-white border-2 md:border-4 border-p5-red px-3 md:px-6 py-3 md:py-5 -skew-x-[3deg] ml-1 sm:ml-0 shadow-[4px_4px_0_0_#E50012] sm:shadow-[6px_6px_0_0_#E50012] md:shadow-[8px_8px_0_0_#E50012] md:hover:-translate-y-1 transition-transform"
            >
              <div class="skew-x-[3deg]">
                <div class="font-display text-xl md:text-3xl uppercase leading-none">
