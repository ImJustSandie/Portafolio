---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/p5/NavBar.astro";
import { ProjectViews } from "../components/p5/ProjectViews";
import type { ProjectData } from "../types";
import proyectos from "../data/proyectos.json";

const toFlatProject = (p: ProjectData) => ({
  title: p.title,
  description: p.description,
  tags: p.tags,
  featured: p.featured,
  mediaUrl: p.media?.[0]?.type === 'video' ? p.media?.[1]?.url : p.media?.[0]?.url,
  media: p.media ?? [],
  role: p.role,
  primaryButton: p.primaryButton,
  secondaryButton: p.secondaryButton,
});

const proyectosTyped = proyectos as ProjectData[];
const juegosProjects = proyectosTyped.filter((p) => p.category === "juegos").map(toFlatProject);
const devProjects = proyectosTyped.filter((p) => p.category === "dev").map(toFlatProject);
const artProjects = proyectosTyped.filter((p) => p.category === "art").map(toFlatProject);
---

<Layout title="Proyectos - Alejandro Sandoval">
  <!-- Navigation Bar -->
  <NavBar currentPath="/proyectos" />

  <div class="space-y-12 md:space-y-32 pb-32 md:pb-40 px-2 md:px-8 w-full max-w-none mx-auto">
    <section class="flex flex-col gap-6 md:gap-12 mt-8 md:mt-16 relative">
      <h1 class="font-display text-2xl sm:text-3xl md:text-5xl lg:text-7xl bg-p5-black text-p5-white inline-block px-3 sm:px-4 md:px-8 py-2 sm:py-2 md:py-4 -skew-x-[6deg] shadow-[4px_4px_0_0_#F4F4F4] sm:shadow-[6px_6px_0_0_#F4F4F4] md:shadow-hard-white self-center mb-4 md:mb-8 ml-2 sm:ml-0 transition-colors" id="project-title-heading">
        <span class="inline-block skew-x-[6deg]">ALL PROJECTS</span>
      </h1>

      <ProjectViews 
        client:load 
        juegosProjects={juegosProjects}
        devProjects={devProjects} 
        artProjects={artProjects} 
      />
    </section>
  </div>
</Layout>
